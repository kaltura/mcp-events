# Kaltura Session — required to connect to the MCP server (sent as "Authorization: ks <KS>").
KALTURA_KS=XXXXXXXXXXXXX
# --- Agent-under-test LLM ---
# Option A (LiteLLM / proxy): point the Anthropic SDK at the proxy and use a bearer token.
#   These mirror the env vars Claude Code itself uses, but Claude Code's settings.json
#   env does NOT propagate to this separate python process — set them here.
ANTHROPIC_BASE_URL=http://127.0.0.1:10006
ANTHROPIC_AUTH_TOKEN=YYYYYYYYYYY
ANTHROPIC_MODEL=claude-4-5-haiku